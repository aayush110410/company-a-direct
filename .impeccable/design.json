  "narrative": {
    "northStar": "The Pass at Night",
    "overview": "Company A is a chef's open kitchen after dark. The customer stands at the pass: slate and steel surfaces joined by 1px seams, warm white type, food lit in full colour against the dark, and exactly one brass control that says what to do next. When the order is paid it becomes a paper ticket, the same object the cooks read, and clips onto that outlet's steel rail. The kitchen display is the same world seen from the line: darker slate, paper tickets hanging in four columns, a steel, amber or red band across each ticket's head that tells urgency from two metres away. Admin is the same company's daytime office: a paper ledger, ink type, deep brass for its one primary action. Three themes, one material vocabulary (slate, steel, paper, ink, brass) and one pair of typefaces. The build refuses the orange delivery-app card grid: menus are rows and one featured plate per category, not tiles.",
    "keyCharacteristics": [
      "Dark, warm-neutral customer surfaces; tonal layering by seams, not shadows.",
      "One brass action per view; everything else is warm white, ash or outline.",
      "Paper tickets are the signature object, shared by the order status screen and the kitchen board.",
      "Gloock for dish names, headlines and the arrival time; Hanken Grotesk with tabular figures for everything operational.",
      "Untinted food photography is the only colour field on customer screens.",
      "One authored moment per surface (ticket drop); every other transition is 150–220 ms ease-out-expo."
    ],
    "rules": [
      {
        "name": "The One Brass Rule",
        "body": "Brass fills exactly one control per view: the next step. Secondary actions are outline or ghost in warm white; selection uses warm white, never brass. If a second brass fill appears, one of them is wrong.",
        "section": "colors"
      },
      {
        "name": "The Signal Is Not Text Rule",
        "body": "Signal colours fill bands, dots and borders. Words that carry status use `--ok-text`, `--risk-text`, `--late-text` for the current theme, which are tuned for AA on that theme's ground.",
        "section": "colors"
      },
      {
        "name": "The Fixed Paper Rule",
        "body": "Ticket paper and ink are the same in every theme. Do not theme a ticket.",
        "section": "colors"
      },
      {
        "name": "The Chalkboard Rule",
        "body": "Gloock is for names and times a person reads once and remembers. Buttons, forms, tables, numbers and kitchen ticket bodies are Hanken Grotesk.",
        "section": "typography"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every number that changes or lines up (price, qty, time, count, order id) is tabular.",
        "section": "typography"
      },
      {
        "name": "The Plate Rule",
        "body": "A plate label is a section heading or a field label. It never sits above a headline as a kicker.",
        "section": "typography"
      },
      {
        "name": "The Seam Not Shadow Rule",
        "body": "Panels, rows, fields and cards separate by 1px seams and tonal steps. Only tickets cast a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do give each view one brass action, and keep selection states in warm white.",
      "Do set status words in `--ok-text`, `--risk-text`, `--late-text` and keep signal colours for bands, dots and borders.",
      "Do re-declare the `--color-*` role tokens in any new `[data-theme]` scope.",
      "Do use the paper ticket for anything that represents an order, with its band, tabular id and written status.",
      "Do keep numbers tabular and dish names in Gloock.",
      "Do meet the kitchen floor: 24px body, 32px order id, 64px targets.",
      "Do show food photography untinted and route remote photos through the image loader."
    ],
    "donts": [
      "Don't build menus as a grid of cards; use featured plates and rows.",
      "Don't put brass on more than one control in a view, or use brass as decoration.",
      "Don't put a plate label above a headline as a kicker.",
      "Don't shadow anything but a ticket.",
      "Don't theme ticket paper, or recolour food photography.",
      "Don't signal state by colour alone.",
      "Don't add motion beyond the ticket drop without removing something; keep transitions within 150–220ms."
    ]
  }
}