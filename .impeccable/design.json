    {
      "name": "Paper Ticket",
      "kind": "custom",
      "refersTo": "ticket",
      "description": "Signature: the order as a paper slip on the rail, shared by kitchen and customer.",
      "html": "<article class=\"ds-ticket\"><header><span>1042</span><span>Ready by 8:25 pm</span></header><ul><li><b>2&times;</b> Chicken dum biryani</li><li><b>1&times;</b> Mirchi ka salan</li></ul><div class=\"ds-ticket-act\"><button>Start</button></div></article>",
      "css": ".ds-ticket{max-width:320px;border-radius:6px;overflow:hidden;background:#f4f1ea;color:#161514;box-shadow:0 22px 40px -22px rgba(0,0,0,.9);font-family:'Hanken Grotesk',system-ui,sans-serif}.ds-ticket header{display:flex;justify-content:space-between;align-items:baseline;padding:10px 16px;background:#34312b;color:#f4f1ea}.ds-ticket header span:first-child{font-size:32px;font-weight:700;letter-spacing:-.02em;font-variant-numeric:tabular-nums;line-height:1}.ds-ticket header span:last-child{font-weight:600}.ds-ticket ul{list-style:none;margin:0;padding:12px 16px 8px;font-size:24px}.ds-ticket-act{border-top:1px solid #ddd7cb;padding:12px}.ds-ticket-act button{width:100%;height:64px;border:0;border-radius:12px;background:#161514;color:#f4f1ea;font:600 18px 'Hanken Grotesk',system-ui,sans-serif;transition:background-color 150ms ease-out,transform 150ms ease-out;cursor:pointer}.ds-ticket-act button:hover{background:#2a2826}.ds-ticket-act button:active{transform:scale(.98)}.ds-ticket-act button:focus-visible{outline:2px solid #c9a46a;outline-offset:3px}"
    }
