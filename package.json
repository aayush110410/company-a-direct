{
  "name": "company-a-direct",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit --project dom",
    "test:db": "vitest run --project db",
    "e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset && pnpm seed",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.ts",
    "seed:remote": "tsx --env-file=.env.production.local scripts/seed.ts",
    "train:prep": "tsx --env-file-if-exists=.env.local scripts/train-prep.ts",
    "dev-order": "tsx --env-file-if-exists=.env.local scripts/dev-order.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24"
  }
}
