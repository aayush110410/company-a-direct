# Supabase project URL (local: http://127.0.0.1:54321 from `supabase status -o env`)
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anon / publishable key — safe in the browser, RLS protects data
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key — server only, never commit or expose
SUPABASE_SERVICE_ROLE_KEY=
# Public URL of this app (local: http://localhost:3000)
APP_URL=
# "true" shows one-tap demo logins and the admin demo tools, and ignores outlet hours.
# Defaults to false; set true locally and on the review deployment.
DEMO_MODE=
# Password set on seeded demo accounts (defaults to the documented demo password)
DEMO_USER_PASSWORD=
